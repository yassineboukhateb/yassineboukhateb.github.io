@misc{boukhateb2026geometry,
  title={Geometry and barycenters in large {CAT}($\kappa$) spaces},
  author={Boukhateb, Yassine and Brunel, Victor-Emmanuel and Stromme, Austin J.},
  year={2026},
  month={October},
  eprint={2610.17909},
  archivePrefix={arXiv},
  primaryClass={math.MG},
  arxiv={2610.17909},
  pdf={https://arxiv.org/pdf/2610.17909},
  note={Preprint, arXiv:2610.17909 [math.MG]},
  bibtex_show={true},
  selected={true},
  abstract={We study the geometry and resulting properties of Fr{\'e}chet functions and barycenters in metric spaces with curvature bounded above by a positive constant in the sense of Alexandrov. Existing results typically rely on the assumption that the support is small enough that the squared distance, and thus the Fr{\'e}chet function, is strongly geodesically convex. We work in the sharper regime where existence and uniqueness of the barycenter are guaranteed, but where convexity typically fails. We develop new geometric properties of these spaces, including a quantitative four-point inequality and a geodesic stability result. Using these tools, we establish new finite sample error bounds for two statistical estimators: the empirical barycenter and the iterated barycenter, as well as new results on sparse representations and approximations of barycenters.}
}
